                <div class="contact-agileits">
                    <h4>Liên hệ đặt phòng</h4>
                    <h5 style="color:white; font-size:18px">Chỉ cần để lại thông tin liên lạc, chúng tôi sẽ liên hệ với bạn để giúp bạn có một căn phòng cùng những dịch vụ tốt nhất khi đến đây.</h5>
                    <br />
                    @using (Html.BeginForm("Create", "Hotel", FormMethod.Post, new { @name = "sentMessage", @id = "contactForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @*<form method="post" action="/Hotel/Create" name="sentMessage" id="contactForm">*@
                        <div class="control-group form-group">
                            <label class="contact-p1">Họ và tên:</label>
                            <input type="text" class="form-control" name="hoTen" id="name" required>
                            <p class="help-block"></p>
                        </div>

                        <div class="control-group form-group">

                            <label class="contact-p1">Số điện thoại:</label>
                            <input type="tel" class="form-control" name="sdt" id="phone" required>
                            <p class="help-block"></p>
                        </div>

                        <div class="control-group form-group">
                            <label class="contact-p1">Địa chỉ email:</label>
                            <input type="email" class="form-control" name="email" id="email" required>
                            <p class="help-block"></p>
                        </div>

                        <div class="control-group form-group">
                            <label class="contact-p1">Ngày đến:</label>
                            <input type="datetime-local" id="ngayDen" name="ngayDen" class="form-control">
                            <p class="help-block"></p>
                        </div>

                                            <div class="control-group form-group">
                            <label class="contact-p1">Ngày Đi:</label>
                            <input type="datetime-local" id="ngayDi" name="ngayDi" class="form-control">
                            <p class="help-block"></p>
                        </div>

                        <input type="submit" name="sub" value="Gửi ngay" class="btn btn-primary">
                    }
                </div>
