@model IEnumerable<DoAnHMS.Models.PhieuDatPhong>
@{
    ViewBag.Title = "Quản lý Phiếu Đặt";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    WebGrid webGrid = new WebGrid(Model, canPage: true, defaultSort: "maPDP", rowsPerPage: 5);
}

<style>
    /* Tổng thể */
    .dashboard-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 25px;
        margin-top: 20px;
    }

    #WebGrid {
        border-collapse: separate;
        width: 100%;
        border-radius: 8px;
        overflow: hidden;
    }

        #WebGrid th {
            background-color: #4e73df;
            color: white;
            padding: 12px;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

    .alternatingRowStyle {
        background-color: #f8f9fc;
    }

    /* Grid con */
    .ChildGrid {
        width: 95%;
        margin: 10px auto !important;
        border: 1px solid #e3e6f0;
    }

        .ChildGrid th {
            background-color: #1cc88a !important;
            font-size: 0.8rem !important;
        }

    .expander {
        cursor: pointer;
        width: 20px;
        transition: 0.2s;
    }

    .status-badge {
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .bg-booked {
        background: #fff3cd;
        color: #856404;
    }

    .bg-checked {
        background: #d1e7dd;
        color: #0f5132;
    }

    .hide-col {
        display: none;
    }
</style>

<div class="container-fluid">
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-primary font-weight-bold m-0"><i class="fas fa-clipboard-list"></i> QUẢN LÝ ĐẶT PHÒNG</h3>
            @Html.ActionLink("Thêm mới phiếu", "Create", null, new { @class = "btn btn-primary" })
        </div>

        <div id="gridContent" class="table-responsive">
            @webGrid.GetHtml(
                htmlAttributes: new { @id = "WebGrid" },
                tableStyle: "table table-hover",
                footerStyle: "grid-footer text-center",
                mode: WebGridPagerModes.All,
                alternatingRowStyle: "alternatingRowStyle",
                columns: webGrid.Columns(
                    // 1. Cột mở rộng
                    webGrid.Column(null, null, format: @<text>
                            <img src="/Images/plus.png" class="expander" />
                            <div class="nested-content" style="display:none"></div>
                    </text>, style: "text-center"),

             // 2. STT và thông tin phiếu (Dùng biến pdp)
             webGrid.Column("STT", format: pdp => pdp.WebGrid.Rows.IndexOf(pdp) + 1 + (webGrid.PageIndex * webGrid.RowsPerPage)),
             webGrid.Column("maPDP", "Mã Phiếu"),
             webGrid.Column("ngayDen", "Ngày đến", format: pdp => pdp.ngayDen.ToString("dd/MM/yyyy")),
             webGrid.Column("ngayDi", "Ngày đi", format: pdp => pdp.ngayDi.ToString("dd/MM/yyyy")),
             webGrid.Column("tongTienCoc", "Tổng cọc", format: pdp => string.Format("{0:#,##0} VNĐ", pdp.tongTienCoc)),
             webGrid.Column("tinhTrang", "Trạng thái", format: @<text>
                    <span class="status-badge @(item.tinhTrang == true ? "bg-checked" : "bg-booked")">
                        @(item.tinhTrang == true ? "Đã nhận phòng" : "Chưa nhận")
                    </span>
            </text>),
     webGrid.Column("KhachHang.tenKH", "Khách hàng"),

     // 3. Cột chứa Grid con (Đã FIX lỗi item2)
     webGrid.Column(header: "", style: "hide-col", format: (pdp) =>
     {
         WebGrid childGrid = new WebGrid(source: pdp.CTPhieuDatPhongs, canSort: false, canPage: false);
         return childGrid.GetHtml(
             htmlAttributes: new { @class = "ChildGrid table table-sm" },
             columns: childGrid.Columns(
                 childGrid.Column("STT", format: ct => ct.WebGrid.Rows.IndexOf(ct) + 1),
                 childGrid.Column("maP", "Phòng"),
                 // Sửa lỗi tại đây: Dùng ct thay cho item2 và ép kiểu rõ ràng
                 childGrid.Column("tienCoc", "Tiền cọc", format: ct => string.Format("{0:#,##0} VNĐ", ct.tienCoc)),
                 childGrid.Column("Phong.LoaiPhong.tenLP", "Loại Phòng"),
                 childGrid.Column("Phong.LoaiPhong.sucChua", "Sức chứa", style: "text-center")
             ));
     }),

     // 4. Thao tác
     webGrid.Column("Thao tác", format: @<text>
            <div class="btn-group">
                <a href="@Url.Action("Edit", new { id = item.maPDP })" class="text-primary mr-2"><i class="fas fa-edit"></i></a>
                <a href="@Url.Action("Details", new { id = item.maPDP })" class="text-info mr-2"><i class="fas fa-info-circle"></i></a>
                <a href="@Url.Action("Delete", new { id = item.maPDP })" class="text-danger"><i class="fas fa-trash"></i></a>
            </div>
    </text>)
)
)
        </div>
    </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
    $(function () {
        // Ẩn cột thứ 9 (cột chứa Grid con thô)
        $("#WebGrid th:nth-child(9)").hide();

        $("#WebGrid .ChildGrid").each(function () {
            var content = $(this).get(0).outerHTML;
            $(this).closest("tr").find(".nested-content").html(content);
            $(this).remove();
        });

        $("body").on("click", ".expander", function () {
            var tr = $(this).closest("tr");
            if ($(this).attr("src").indexOf("plus.png") !== -1) {
                $(this).attr("src", "/Images/minus.png");
                tr.after("<tr class='expanded-row'><td style='background:#f1f1f1'></td><td colspan='8' style='background:#f1f1f1'>" + tr.find(".nested-content").html() + "</td></tr>");
            } else {
                $(this).attr("src", "/Images/plus.png");
                tr.next(".expanded-row").remove();
            }
        });
    });
</script>