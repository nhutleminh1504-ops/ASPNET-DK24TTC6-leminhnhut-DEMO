@model DoAnHMS.Models.Phong

@{
    ViewBag.Title = "Phòng - Thêm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .create-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        padding: 30px;
        margin-top: 30px;
        border-top: 5px solid #3498db; /* Màu xanh dương chủ đạo */
    }

    .form-header {
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

    .control-label {
        font-weight: 600;
        color: #444;
    }

    .input-group-addon {
        background-color: #f8f9fa;
        color: #3498db;
    }

    .radio-container {
        display: flex;
        gap: 20px;
        padding-top: 7px;
    }

    .btn-save {
        padding: 10px 30px;
        font-weight: bold;
        background-color: #3498db;
        border: none;
        transition: 0.3s;
    }

        .btn-save:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
        }
</style>

<div class="container">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="create-card">
                <div class="form-header">
                    <h2 class="text-primary"><i class="fa fa-plus-circle"></i> THÊM PHÒNG MỚI</h2>
                    <small class="text-muted">Nhập đầy đủ thông tin bên dưới để đăng ký phòng vào hệ thống.</small>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(model => model.maP, "Mã phòng", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class="input-group">
                                    <span class="input-group-addon"><i class="fa fa-tag"></i></span>
                                    @Html.EditorFor(model => model.maP, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: P101, P102..." } })
                                </div>
                                @Html.ValidationMessageFor(model => model.maP, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.maLP, "Loại phòng", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class="input-group">
                                    <span class="input-group-addon"><i class="fa fa-bed"></i></span>
                                    @Html.DropDownList("maLP", null, "-- Chọn loại phòng --", htmlAttributes: new { @class = "form-control" })
                                </div>
                                @Html.ValidationMessageFor(model => model.maLP, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.tinhTrang, "Tình trạng", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-9">
                                <div class="radio-container">
                                    <label style="cursor:pointer">
                                        @Html.RadioButtonFor(model => model.tinhTrang, true, new { @checked = "checked" })
                                        <span class="label label-success" style="margin-left:5px">Trống</span>
                                    </label>
                                    <label style="cursor:pointer">
                                        @Html.RadioButtonFor(model => model.tinhTrang, false)
                                        <span class="label label-danger" style="margin-left:5px">Đang sử dụng</span>
                                    </label>
                                </div>
                                @Html.ValidationMessageFor(model => model.tinhTrang, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <hr />

                        <div class="form-group">
                            <div class="col-md-offset-3 col-md-9">
                                <button type="submit" class="btn btn-primary btn-save">
                                    <i class="fa fa-check"></i> Lưu thông tin
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-default" style="padding: 10px 20px; margin-left: 10px;">
                                    <i class="fa fa-undo"></i> Hủy bỏ
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>