@model IEnumerable<DoAnHMS.Models.Phong>
@{
    ViewBag.Title = "Danh sách phòng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var grid = new WebGrid(Model, canPage: true, defaultSort: "maP", rowsPerPage: 5);
}

<style type="text/css">

    .grid-footer {
        color: #000;
        font: 17px Calibri;
        text-align: center;
        font-weight: bold;
    }

        .grid-footer a {
            background-color: #ffffff;
            color: blue;
            box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
            padding: 1px 10px 2px 10px;
            text-decoration: none;
        }

            .grid-footer a:hover {
                color: #FFAD33;
            }

    .alternatingRowStyle {
        background-color: aliceblue;
    }

    .img-room {
        width: 80px;
        height: auto;
        border-radius: 5px;
    }

    #gridContent {
        padding: 20px;
    }
</style>

<h3>DANH SÁCH PHÒNG</h3>

<p>
    @Html.ActionLink("Thêm mới phòng", "Create", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Tìm kiếm", "Timkiem", null, new { @class = "btn btn-info" })
</p>

<div id="gridContent">
    @grid.GetHtml(
        tableStyle: "table table-bordered table-hover",
        footerStyle: "grid-footer",
        fillEmptyRows: false,
        mode: WebGridPagerModes.All,
        alternatingRowStyle: "alternatingRowStyle",
        columns: grid.Columns(
                       grid.Column(header: "STT", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),

                    grid.Column("maP", "Mã phòng"),

           
            grid.Column("maLP", "Mã loại"),

                      grid.Column("LoaiPhong.hinhAnh", "Hình Ảnh", format: @<text><img src="@Url.Content("~/Images/" + item.LoaiPhong.hinhAnh)" class="img-room" /></text>),

grid.Column("LoaiPhong.donGia", "Đơn giá", format: @<text>@item.LoaiPhong.donGia.ToString("#,##0") VNĐ</text>),

grid.Column("tinhTrang", "Tình trạng", format: @<text>@(item.tinhTrang.ToString() == "True" ? "Đang trống" : "Đã đặt")</text>),

grid.Column("Chức năng", format: @<text>
    <a href="@Url.Action("Edit", new { id = item.maP })"><img src="/images/edit.png" width="20" title="Sửa" /></a>
    <a href="@Url.Action("Details", new { id = item.maP })"><img src="/images/details.png" width="20" title="Chi tiết" /></a>
    <a href="@Url.Action("Delete", new { id = item.maP })"><img src="/images/delete.png" width="20" title="Xóa" /></a>
</text>)
)
)
</div>