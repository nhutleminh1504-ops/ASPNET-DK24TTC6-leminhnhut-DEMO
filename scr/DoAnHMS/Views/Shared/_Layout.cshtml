<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title | Hoàng Gia Hotel</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8fafc;
        }

        .navbar {
            background: linear-gradient(90deg,#1e3a8a,#2563eb);
            border: none;
            padding: 12px 0;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
        }

        .navbar-brand {
            color: white !important;
            font-size: 26px;
            font-weight: 700;
        }

        .navbar-nav li a {
            color: white !important;
            font-weight: 500;
            transition: .3s;
        }

            .navbar-nav li a:hover {
                color: #ffd700 !important;
            }

        .body-content {
            background: white;
            margin-top: 90px;
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        footer {
            text-align: center;
            padding-top: 20px;
            color: #777;
        }

        .welcome {
            color: #fff;
            padding: 15px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">

            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                @Html.ActionLink("HOANG GIA", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            </div>

            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                    <li>@Html.ActionLink("Giới thiệu", "About", "Home")</li>
                    <li>@Html.ActionLink("Liên hệ", "Contact", "Home")</li>

                    @{
                        var session = (DoAnHMS.Common.UserLogin)Session[DoAnHMS.Common.CommonConstants.USER_SESSION];
                    }

                    @if (session != null)
                    {
                        <li class="welcome">Xin chào: @session.UserName</li>
                        <li>@Html.ActionLink("Đăng xuất", "Logout", "Login")</li>
                    }
                </ul>
            </div>

        </div>
    </div>

    <div class="container body-content">
        @RenderBody()

        <footer>
            <p>© @DateTime.Now.Year - Hoàng Gia Hotel</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>