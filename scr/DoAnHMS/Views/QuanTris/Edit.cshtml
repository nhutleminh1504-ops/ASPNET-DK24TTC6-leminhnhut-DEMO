@model DoAnHMS.Models.QuanTri

@{
    ViewBag.Title = "Cập nhật tài khoản nhân viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --luxury-bg: #f8f9fa;
    }

    .edit-wrapper {
        padding: 40px 0;
        background-color: var(--luxury-bg);
        min-height: 100vh;
    }

    .security-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 15px 50px rgba(0,0,0,0.05);
        position: relative;
    }

        /* Đường kẻ vàng thượng lưu phía trên */
        .security-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--luxury-gold);
        }

    .card-header-luxury {
        background: #fff;
        padding: 40px 40px 10px;
        border: none;
    }

        .card-header-luxury h3 {
            font-family: 'Playfair Display', serif;
            color: var(--luxury-navy);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.4rem;
        }

    .card-body-luxury {
        padding: 30px 40px 40px;
    }

    /* Label & Input Design */
    .label-luxury {
        font-size: 11px;
        font-weight: 700;
        color: var(--luxury-gold);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
        display: block;
    }

    .input-group-luxury {
        border-bottom: 1px solid #eee;
        margin-bottom: 25px;
        transition: all 0.3s;
    }

        .input-group-luxury:focus-within {
            border-bottom: 1px solid var(--luxury-gold);
        }

    .input-luxury {
        border: none !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 10px 0 !important;
        font-weight: 500;
        color: var(--luxury-navy);
    }

        .input-luxury[readonly], .input-luxury:disabled {
            color: #999 !important;
            cursor: not-allowed;
        }

    .input-group-text-luxury {
        background: none !important;
        border: none !important;
        color: #ccc;
        padding-left: 0;
        font-size: 14px;
    }

    /* Status Radio Design */
    .status-panel {
        background: #fdfdfd;
        border: 1px solid #f8f9fa;
        padding: 20px;
        margin-top: 5px;
    }

    .radio-luxury {
        margin-right: 25px;
        cursor: pointer;
        font-weight: 600;
        color: var(--luxury-navy);
        font-size: 14px;
    }

        .radio-luxury input[type="radio"] {
            accent-color: var(--luxury-gold);
            transform: scale(1.1);
            margin-right: 8px;
        }

    /* Buttons */
    .btn-luxury-save {
        background: var(--luxury-navy);
        color: #fff;
        border-radius: 0;
        padding: 15px 45px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: none;
        transition: all 0.4s;
    }

        .btn-luxury-save:hover {
            background: var(--luxury-gold);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
        }

    .btn-back-link {
        color: #999;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        font-weight: 700;
    }

        .btn-back-link:hover {
            color: var(--luxury-navy);
            text-decoration: none;
        }
</style>

<div class="edit-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <div class="security-card">

                    <div class="card-header-luxury d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="m-0">Cập nhật tài khoản</h3>
                            <p class="text-muted small mt-1">Quản lý bảo mật định danh nhân viên</p>
                        </div>
                        <i class="fas fa-shield-alt fa-2x" style="color: #f1f1f1;"></i>
                    </div>

                    <div class="card-body-luxury">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small" })
                            @Html.HiddenFor(model => model.username)
                            @Html.HiddenFor(model => model.maNV)

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Tên đăng nhập</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-user-lock"></i></span>
                                            </div>
                                            @Html.EditorFor(model => model.username, new { htmlAttributes = new { @class = "form-control input-luxury", disabled = "disabled", @readonly = "readonly" } })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Mật khẩu mới</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-key"></i></span>
                                            </div>
                                            @Html.PasswordFor(model => model.password, new { @class = "form-control input-luxury", placeholder = "Để trống nếu không đổi" })
                                            <input type="password" name="oldPass" style="display:none" value="@ViewBag.oldPass" />
                                        </div>
                                        @Html.ValidationMessageFor(model => model.password, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Nhân viên sở hữu</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-id-badge"></i></span>
                                            </div>
                                            @Html.DropDownList("maNV", null, htmlAttributes: new { @class = "form-control input-luxury", disabled = "disabled" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Nhóm quyền hạn</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-users-cog"></i></span>
                                            </div>
                                            @Html.DropDownList("IDNhom", null, htmlAttributes: new { @class = "form-control input-luxury" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.IDNhom, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mt-4">
                                <label class="label-luxury">Trạng thái hoạt động</label>
                                <div class="status-panel">
                                    <label class="radio-luxury mb-0">
                                        @Html.RadioButtonFor(model => model.tinhTrang, "True") Hoạt động
                                    </label>
                                    <label class="radio-luxury mb-0">
                                        @Html.RadioButtonFor(model => model.tinhTrang, "False") Tạm khóa tài khoản
                                    </label>
                                </div>
                                @Html.ValidationMessageFor(model => model.tinhTrang, "", new { @class = "text-danger small" })
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-5">
                                <a href="@Url.Action("Index")" class="btn-back-link">
                                    <i class="fas fa-chevron-left mr-2"></i> Trở về danh sách
                                </a>
                                <button type="submit" class="btn btn-luxury-save shadow">
                                    Lưu thay đổi <i class="fas fa-check-circle ml-2"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>