@model DoAnHMS.Models.QuanTri

@{
    ViewBag.Title = "Cấp tài khoản hệ thống";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --luxury-bg: #f8f9fa;
    }

    .create-wrapper {
        padding: 40px 0;
        background-color: var(--luxury-bg);
        min-height: 100vh;
    }

    .security-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 15px 50px rgba(0,0,0,0.05);
        position: relative;
    }

        .security-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--luxury-gold);
        }

    .card-header-luxury {
        padding: 40px 40px 10px;
        background: #fff;
    }

        .card-header-luxury h3 {
            font-family: 'Playfair Display', serif;
            color: var(--luxury-navy);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.4rem;
        }

    /* Label & Input Design */
    .label-luxury {
        font-size: 11px;
        font-weight: 700;
        color: var(--luxury-gold);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
        display: block;
    }

    .input-group-luxury {
        border-bottom: 1px solid #eee;
        margin-bottom: 25px;
        transition: all 0.3s;
    }

        .input-group-luxury:focus-within {
            border-bottom: 1px solid var(--luxury-gold);
        }

    .input-luxury {
        border: none !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
        padding: 10px 0 !important;
        font-weight: 500;
        color: var(--luxury-navy);
        width: 100%;
    }

    .input-group-text-luxury {
        background: none !important;
        border: none !important;
        color: #ccc;
        padding-left: 0;
        font-size: 14px;
    }

    /* Status Panel */
    .status-panel {
        background: #fdfdfd;
        border: 1px solid #f8f9fa;
        padding: 20px;
        margin-top: 5px;
    }

    .radio-luxury {
        margin-right: 25px;
        cursor: pointer;
        font-weight: 600;
        color: var(--luxury-navy);
        font-size: 14px;
    }

        .radio-luxury input[type="radio"] {
            accent-color: var(--luxury-gold);
            margin-right: 8px;
        }

    /* Buttons */
    .btn-luxury-create {
        background: var(--luxury-navy);
        color: #fff;
        border-radius: 0;
        padding: 15px 45px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: none;
        transition: all 0.4s;
    }

        .btn-luxury-create:hover {
            background: var(--luxury-gold);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
        }
</style>

<div class="create-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <div class="security-card">
                    <div class="card-header-luxury d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="m-0">Cấp tài khoản mới</h3>
                            <p class="text-muted small mt-1">Khởi tạo thông tin định danh và quyền hạn truy cập</p>
                        </div>
                        <i class="fas fa-user-shield fa-2x" style="color: #f1f1f1;"></i>
                    </div>

                    <div class="card-body p-5">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Tên đăng nhập</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-id-badge"></i></span>
                                            </div>
                                            @Html.EditorFor(model => model.username, new { htmlAttributes = new { @class = "form-control input-luxury", placeholder = "VD: nhanvien01" } })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.username, "", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Mật khẩu khởi tạo</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-key"></i></span>
                                            </div>
                                            @Html.PasswordFor(model => model.password, new { @class = "form-control input-luxury", placeholder = "••••••••" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.password, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Nhân viên sở hữu</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-user-check"></i></span>
                                            </div>
                                            @Html.DropDownList("maNV", null, "-- Chọn nhân viên --", htmlAttributes: new { @class = "form-control input-luxury" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.maNV, "", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="label-luxury">Nhóm quyền hạn</label>
                                        <div class="input-group input-group-luxury">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text-luxury"><i class="fas fa-layer-group"></i></span>
                                            </div>
                                            @Html.DropDownList("IDNhom", null, "-- Chọn phân quyền --", htmlAttributes: new { @class = "form-control input-luxury" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.IDNhom, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group mt-4">
                                <label class="label-luxury">Trạng thái tài khoản</label>
                                <div class="status-panel">
                                    <label class="radio-luxury mb-0">
                                        @Html.RadioButtonFor(model => model.tinhTrang, "True", new { @checked = "checked" }) Cho phép hoạt động
                                    </label>
                                    <label class="radio-luxury mb-0">
                                        @Html.RadioButtonFor(model => model.tinhTrang, "False") Tạm thời khóa
                                    </label>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-5">
                                <a href="@Url.Action("Index")" class="text-muted small font-weight-bold" style="text-decoration:none; letter-spacing:1px;">
                                    <i class="fas fa-chevron-left mr-2"></i> TRỞ VỀ DANH SÁCH
                                </a>
                                <button type="submit" class="btn btn-luxury-create shadow">
                                    XÁC NHẬN CẤP MỚI <i class="fas fa-plus-circle ml-2"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>