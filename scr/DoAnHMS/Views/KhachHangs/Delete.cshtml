@model DoAnHMS.Models.KhachHang

@{
    ViewBag.Title = "Xác nhận gỡ bỏ hồ sơ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
  
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --luxury-danger: #8b0000; 
        --luxury-bg: #f8f9fa;
    }

    .luxury-wrapper {
        padding: 50px 0;
        background-color: var(--luxury-bg);
        min-height: 100vh;
    }

    .delete-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 20px 60px rgba(0,0,0,0.06);
        position: relative;
    }

    
        .delete-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--luxury-danger);
        }

    .card-header-warning {
        padding: 50px 40px 20px;
        text-align: center;
    }

        .card-header-warning h3 {
            font-family: 'Playfair Display', serif;
            color: var(--luxury-danger);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.4rem;
        }

    .warning-subtitle {
        color: #999;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .card-body-luxury {
        padding: 40px 60px;
    }

 
    .info-section {
        border-top: 1px solid #f1f1f1;
        border-bottom: 1px solid #f1f1f1;
        padding: 30px 0;
        margin-bottom: 30px;
    }

    .data-row {
        margin-bottom: 20px;
    }

    .data-label {
        font-size: 11px;
        font-weight: 700;
        color: #bbb;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .data-value {
        font-size: 1.1rem;
        color: var(--luxury-navy);
        font-weight: 500;
    }

 
    .btn-luxury-delete {
        background: var(--luxury-danger);
        color: #fff;
        border-radius: 0;
        padding: 15px 45px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: none;
        transition: all 0.4s;
    }

        .btn-luxury-delete:hover {
            background: #000;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .btn-luxury-back {
        color: var(--luxury-navy);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s;
        border-bottom: 1px solid transparent;
    }

        .btn-luxury-back:hover {
            color: var(--luxury-gold);
            border-bottom: 1px solid var(--luxury-gold);
            text-decoration: none;
        }

    .guest-icon {
        font-size: 3rem;
        color: #f1f1f1;
        margin-bottom: 15px;
    }
</style>

<div class="luxury-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <div class="delete-card">

                    <div class="card-header-warning">
                        <div class="guest-icon"><i class="fas fa-user-times"></i></div>
                        <span class="warning-subtitle">Hành động này không thể hoàn tác</span>
                        <h3>Xác nhận gỡ bỏ hồ sơ khách hàng</h3>
                    </div>

                    <div class="card-body-luxury">
                        <div class="info-section">
                            <div class="row data-row">
                                <div class="col-sm-6">
                                    <div class="data-label">Danh tính khách hàng</div>
                                    <div class="data-value">@Model.tenKH</div>
                                </div>
                                <div class="col-sm-6 text-sm-right">
                                    <div class="data-label">Mã thành viên</div>
                                    <div class="data-value">#@Model.maKH</div>
                                </div>
                            </div>

                            <div class="row data-row">
                                <div class="col-sm-6">
                                    <div class="data-label">Giới tính</div>
                                    <div class="data-value">@(Model.gioiTinh == true ? "Nam" : "Nữ")</div>
                                </div>
                                <div class="col-sm-6 text-sm-right">
                                    <div class="data-label">CCCD / Passport</div>
                                    <div class="data-value">@Model.cmnd_passport</div>
                                </div>
                            </div>

                            <div class="row data-row">
                                <div class="col-sm-12">
                                    <div class="data-label">Liên lạc</div>
                                    <div class="data-value">@Model.sdt @(string.IsNullOrEmpty(Model.email) ? "" : " | " + Model.email)</div>
                                </div>
                            </div>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="d-flex justify-content-between align-items-center mt-5">
                                <a href="@Url.Action("Index")" class="btn-luxury-back">
                                    <i class="fas fa-chevron-left mr-2"></i> Trở về danh sách
                                </a>

                                <button type="submit" class="btn btn-luxury-delete shadow-sm">
                                    Xác nhận xóa hồ sơ <i class="fas fa-trash-alt ml-2"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>