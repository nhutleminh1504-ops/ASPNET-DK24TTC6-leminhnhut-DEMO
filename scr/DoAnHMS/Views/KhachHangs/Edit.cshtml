@model DoAnHMS.Models.KhachHang

@{
    ViewBag.Title = "Chỉnh sửa khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .edit-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 30px;
        margin-top: 20px;
        border-top: 5px solid #4e73df;
    }

    .control-label {
        font-weight: 700;
        color: #4e73df;
        text-transform: uppercase;
        font-size: 0.8rem;
        margin-bottom: 8px;
    }

    .input-group-text {
        background-color: #f8f9fc;
        color: #4e73df;
        min-width: 45px;
        justify-content: center;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: none;
    }

    .radio-group {
        display: flex;
        gap: 20px;
        padding: 10px 0;
    }

    .btn-save {
        background: linear-gradient(135deg, #4e73df 0%, #2e59d9 100%);
        border: none;
        color: white;
        padding: 12px 35px;
        font-weight: bold;
        border-radius: 5px;
        transition: 0.3s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(78, 115, 223, 0.4);
            color: white;
        }
</style>

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="edit-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="text-primary font-weight-bold m-0">
                        <i class="fas fa-user-edit"></i> CHỈNH SỬA THÔNG TIN KHÁCH HÀNG
                    </h3>
                    <a href="@Url.Action("Index")" class="btn btn-light btn-sm text-secondary">
                        <i class="fas fa-arrow-left"></i> Trở về danh sách
                    </a>
                </div>
                <hr />

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.maKH)

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.maKH, "Mã khách hàng", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.maKH, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.tenKH, "Họ và tên khách hàng", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.tenKH, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập họ tên..." } })
                                </div>
                                @Html.ValidationMessageFor(model => model.tenKH, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.gioiTinh, "Giới tính", htmlAttributes: new { @class = "control-label" })
                                <div class="radio-group">
                                    <label class="mb-0 mr-3">
                                        @Html.RadioButtonFor(model => model.gioiTinh, "True") Nam
                                    </label>
                                    <label class="mb-0">
                                        @Html.RadioButtonFor(model => model.gioiTinh, "False") Nữ
                                    </label>
                                </div>
                                @Html.ValidationMessageFor(model => model.gioiTinh, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.cmnd_passport, "Số CCCD / Hộ chiếu", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-passport"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.cmnd_passport, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.cmnd_passport, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.sdt, "Số điện thoại", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.sdt, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.sdt, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.email, "Địa chỉ Email", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control", placeholder = "example@mail.com" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.quocTich, "Quốc tịch", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-globe-asia"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.quocTich, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.quocTich, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-4">
                                @Html.LabelFor(model => model.diaChi, "Địa chỉ liên lạc", htmlAttributes: new { @class = "control-label" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                    </div>
                                    @Html.EditorFor(model => model.diaChi, new { htmlAttributes = new { @class = "form-control" } })
                                </div>
                                @Html.ValidationMessageFor(model => model.diaChi, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <hr />
                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-save shadow">
                            <i class="fas fa-save mr-2"></i> LƯU THAY ĐỔI
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>