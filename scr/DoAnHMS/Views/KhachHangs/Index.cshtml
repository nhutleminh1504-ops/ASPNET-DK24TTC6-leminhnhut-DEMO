@model IEnumerable<DoAnHMS.Models.KhachHang>

@{
    ViewBag.Title = "Danh sách khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var grid = new WebGrid(Model, canPage: true, defaultSort: "maKH", rowsPerPage: 10);
}

<style type="text/css">
   
    .dashboard-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 25px;
        margin-top: 20px;
    }

    #WebGrid {
        border-collapse: separate;
        width: 100%;
        border-radius: 8px;
        overflow: hidden;
    }

        #WebGrid th {
            background-color: #4e73df;
            color: white;
            padding: 12px;
            font-size: 0.85rem;
            text-transform: uppercase;
            border: none;
        }

    .alternatingRowStyle {
        background-color: #f8f9fc;
    }

    
    .grid-footer {
        text-align: center;
        padding: 20px 0;
    }

        .grid-footer a {
            background-color: #ffffff;
            color: #4e73df;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            padding: 6px 12px;
            border-radius: 4px;
            text-decoration: none;
            margin: 0 3px;
            font-weight: bold;
        }

            .grid-footer a:hover {
                background-color: #4e73df;
                color: white;
            }

    .badge-kh {
        background: #eaecf4;
        color: #5a5c69;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }
</style>

<div class="container-fluid">
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-primary font-weight-bold m-0">
                <i class="fas fa-users"></i> QUẢN LÝ KHÁCH HÀNG
            </h3>
            <div class="action-buttons">
                <a href="@Url.Action("Search")" class="btn btn-info btn-sm shadow-sm mr-2">
                    <i class="fas fa-search"></i> Tìm kiếm
                </a>
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm shadow-sm">
                    <i class="fas fa-plus"></i> Thêm mới khách hàng
                </a>
            </div>
        </div>

        <div id="gridContent" class="table-responsive">
            @grid.GetHtml(
                htmlAttributes: new { @id = "WebGrid" },
                tableStyle: "table table-hover",
                footerStyle: "grid-footer",
                fillEmptyRows: false,
                mode: WebGridPagerModes.All,
                alternatingRowStyle: "alternatingRowStyle",
                columns: grid.Columns(
                    grid.Column("STT", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + (grid.PageIndex * grid.RowsPerPage), style: "text-center"),

                    grid.Column("maKH", "Mã KH", format: @<text><span class="badge-kh">@item.maKH</span></text>, style: "text-center"),

grid.Column("tenKH", "Họ và Tên", style: "font-weight-bold"),

grid.Column("gioiTinh", "Giới tính", format: (item) => item.gioiTinh == true ? "Nam" : "Nữ", style: "text-center"),

grid.Column("cmnd_passport", "CMND/Passport"),

grid.Column("sdt", "Số điện thoại"),

grid.Column("quocTich", "Quốc tịch"),

grid.Column("Thao tác", format: @<text>
                    <div class="btn-group">
                        <a href="@Url.Action("Edit", new { id = item.maKH })" class="btn btn-sm btn-outline-primary" title="Cập nhật">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="@Url.Action("Details", new { id = item.maKH })" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Delete", new { id = item.maKH })" class="btn btn-sm btn-outline-danger" title="Xóa">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </div>
</text>, style: "text-center")
)
)
        </div>
    </div>
</div>