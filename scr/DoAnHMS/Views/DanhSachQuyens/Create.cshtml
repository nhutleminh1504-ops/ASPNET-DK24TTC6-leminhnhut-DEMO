@model DoAnHMS.Models.DanhSachQuyen

@{
    ViewBag.Title = "Thiết lập quyền hạn mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --luxury-bg: #f8f9fa;
    }

    .create-page-wrapper {
        padding: 60px 0;
        background-color: var(--luxury-bg);
        min-height: 90vh;
    }

    .luxury-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 15px 50px rgba(0,0,0,0.05);
        position: relative;
    }

        .luxury-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--luxury-gold);
        }

    .card-header-luxury {
        padding: 40px 40px 10px;
        background: #fff;
    }

        .card-header-luxury h3 {
            font-family: 'Playfair Display', serif;
            color: var(--luxury-navy);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.3rem;
        }

    /* Form Design */
    .label-luxury {
        font-size: 11px;
        font-weight: 700;
        color: var(--luxury-gold);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
        display: block;
    }

    .form-group-luxury {
        margin-bottom: 35px;
    }

    .select-luxury {
        border: none !important;
        border-bottom: 1px solid #eee !important;
        border-radius: 0 !important;
        padding: 10px 0 !important;
        font-size: 15px;
        font-weight: 500;
        color: var(--luxury-navy);
        background: transparent !important;
        box-shadow: none !important;
        transition: 0.3s;
        cursor: pointer;
    }

        .select-luxury:focus {
            border-bottom-color: var(--luxury-gold) !important;
        }

    /* Buttons */
    .btn-create-final {
        background: var(--luxury-navy);
        color: #fff;
        border: none;
        border-radius: 0;
        padding: 15px 45px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        transition: 0.4s;
    }

        .btn-create-final:hover {
            background: var(--luxury-gold);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
        }

    .btn-back-link {
        color: #999;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-back-link:hover {
            color: var(--luxury-navy);
            text-decoration: underline;
        }

    /* Decoration Icon */
    .security-icon-bg {
        position: absolute;
        right: 40px;
        top: 40px;
        color: #f9f9f9;
        font-size: 4rem;
        z-index: 0;
    }
</style>

<div class="create-page-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="luxury-card">
                    <i class="fas fa-key security-icon-bg"></i>

                    <div class="card-header-luxury">
                        <h3>Cấp quyền truy cập</h3>
                        <p class="text-muted small mt-2">Gán chức năng hệ thống vào nhóm nhân sự tương ứng</p>
                    </div>

                    <div class="card-body p-5" style="position: relative; z-index: 1;">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-4" })

                            <div class="form-group-luxury">
                                <label class="label-luxury">Nhóm nhân sự tiếp nhận</label>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-users mr-3 text-muted"></i>
                                    @Html.DropDownList("IDNhom", null, "-- Chọn nhóm nhân viên --", htmlAttributes: new { @class = "form-control select-luxury" })
                                </div>
                                @Html.ValidationMessageFor(model => model.IDNhom, "", new { @class = "text-danger small" })
                            </div>

                            <div class="form-group-luxury">
                                <label class="label-luxury">Quyền hạn / Chức năng</label>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-shield-alt mr-3 text-muted"></i>
                                    @Html.DropDownList("IDQuyen", null, "-- Chọn quyền hạn cấp phép --", htmlAttributes: new { @class = "form-control select-luxury" })
                                </div>
                                @Html.ValidationMessageFor(model => model.IDQuyen, "", new { @class = "text-danger small" })
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                                <a href="@Url.Action("Index")" class="btn-back-link">
                                    <i class="fas fa-chevron-left mr-2"></i> Trở về
                                </a>
                                <button type="submit" class="btn btn-create-final shadow">
                                    Xác nhận cấp quyền <i class="fas fa-lock-open ml-2"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>