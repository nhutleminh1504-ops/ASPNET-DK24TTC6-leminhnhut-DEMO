@model IEnumerable<DoAnHMS.Models.DanhSachQuyen>

@{
    ViewBag.Title = "Quản trị quyền hạn hệ thống";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var grid = new WebGrid(Model, canPage: true, rowsPerPage: 10);
}

<style type="text/css">
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
    }

    .dashboard-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        padding: 30px;
        margin-top: 20px;
        position: relative;
    }

        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--luxury-gold);
        }

    /* Table Design */
    .table-luxury {
        width: 100%;
        margin-top: 20px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-luxury th {
            background-color: #fcfcfc !important;
            color: var(--luxury-navy) !important;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            padding: 15px !important;
            border-bottom: 2px solid #eee !important;
        }

        .table-luxury td {
            padding: 18px 15px !important;
            vertical-align: middle !important;
            font-size: 14px;
            border-bottom: 1px solid #f8f9fa !important;
        }

    /* Permission Tags */
    .role-badge {
        font-weight: 700;
        color: var(--luxury-navy);
        background: #f8f9fa;
        padding: 6px 12px;
        border-left: 3px solid var(--luxury-gold);
        display: inline-block;
    }

    .permission-tag {
        background: #fff8ef;
        color: var(--luxury-gold);
        border: 1px solid #f9ebcf;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
    }

    /* Pagination */
    .grid-footer {
        text-align: center;
        padding-top: 30px;
    }

        .grid-footer a {
            color: var(--luxury-navy);
            padding: 8px 14px;
            text-decoration: none;
            border: 1px solid #eee;
            margin: 0 3px;
            font-size: 12px;
            transition: 0.3s;
        }

            .grid-footer a:hover {
                background: var(--luxury-gold);
                color: #fff;
            }

    .btn-delete-luxury {
        color: #ccc;
        transition: 0.3s;
        font-size: 16px;
    }

        .btn-delete-luxury:hover {
            color: #d9534f;
        }
</style>

<div class="container-fluid">
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 style="font-family: 'Playfair Display', serif; color: var(--luxury-navy); font-weight: 700; letter-spacing: 1px;">CHI TIẾT PHÂN QUYỀN</h3>
                <p class="text-muted small m-0">Thiết lập mối quan hệ giữa chức năng và nhóm người dùng</p>
            </div>
            <a href="@Url.Action("Create")" class="btn shadow-sm" style="background: var(--luxury-navy); color: white; border-radius: 0; font-size: 11px; letter-spacing: 1px; padding: 10px 20px; font-weight: 700;">
                <i class="fas fa-key mr-2"></i> THÊM MỚI QUYỀN TRUY CẬP
            </a>
        </div>

        <div id="gridContent" class="table-responsive">
            @grid.GetHtml(
                tableStyle: "table table-luxury",
                footerStyle: "grid-footer",
                mode: WebGridPagerModes.All,
                columns: grid.Columns(
                    grid.Column("STT", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + (grid.PageIndex * grid.RowsPerPage), style: "text-center"),

                    grid.Column("NhomNhanVien.TenNhom", "Nhóm nhân sự", format: @<text><span class="role-badge">@item.NhomNhanVien.TenNhom</span></text>),

grid.Column("Quyen.TenQuyen", "Quyền hạn được cấp", format: @<text><span class="permission-tag"><i class="fas fa-shield-check mr-2"></i>@item.Quyen.TenQuyen</span></text>),

grid.Column("Thao tác", format: @<text>
    <div class="text-center">
        <a href="@Url.Action("Delete", new { IDNhom = item.IDNhom, IDQuyen = item.IDQuyen })" class="btn-delete-luxury" title="Gỡ bỏ quyền">
            <i class="fas fa-trash-alt"></i>
        </a>
    </div>
</text>, style: "width: 100px;")
)
)
        </div>
    </div>
</div>