@model DoAnHMS.Models.HoaDon
@{
    ViewBag.Title = "Xóa hóa đơn";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <h5 class="text-danger font-weight-bold">XÁC NHẬN XÓA HÓA ĐƠN?</h5>
                    <p>Bạn có chắc chắn muốn xóa hóa đơn <b>@Model.maHD</b>? Hành động này không thể hoàn tác.</p>
                    <table class="table table-sm">
                        <tr><td>Khách hàng:</td><td>@Model.PhieuThuePhong.KhachHang.tenKH</td></tr>
                        <tr><td>Tổng tiền:</td><td>@Model.tongTien.ToString("#,##0") VNĐ</td></tr>
                    </table>
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Xóa vĩnh viễn</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>