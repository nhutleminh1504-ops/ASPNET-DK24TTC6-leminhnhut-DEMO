@model DoAnHMS.Models.PhieuThuePhong

@{
    ViewBag.Title = "Phiếu thuê phòng - Thêm mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .master-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 30px;
        margin-bottom: 30px;
        border-top: 5px solid #4e73df;
    }

    .detail-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        padding: 30px;
        border-top: 5px solid #ff6347;
    }

    .section-title {
        font-weight: bold;
        color: #4e73df;
        margin-bottom: 20px;
        text-transform: uppercase;
        font-size: 1.1rem;
    }

    .section-title-detail {
        color: #ff6347;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: none;
    }

    #detailsTable thead th {
        background-color: #f8f9fc;
        color: #4e73df;
        border-bottom: 2px solid #e3e6f0;
    }
</style>

<div class="container-fluid">
    <div class="master-card">
        <h3 class="section-title"><i class="fas fa-file-invoice"></i> Thêm mới phiếu thuê phòng</h3>
        <hr />

        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "masterForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row">
                <div class="form-group col-md-4">
                    <label class="control-label font-weight-bold">Mã phiếu thuê</label>
                    @Html.EditorFor(model => model.maPTP, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", @Value = ViewBag.maPTP } })
                </div>
                <div class="form-group col-md-4">
                    <label class="control-label font-weight-bold">Nhân viên lập</label>
                    @Html.DropDownList("maNV", null, htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
                    @Html.HiddenFor(model => model.maNV)
                </div>
                <div class="form-group col-md-4">
                    <label class="control-label font-weight-bold">Từ phiếu đặt phòng</label>
                    @Html.DropDownList("maPDP", null, "Thuê trực tiếp (Không có)", htmlAttributes: new { @class = "form-control" })
                </div>
            </div>

            <div class="row">
                <div class="form-group col-md-4">
                    <label class="control-label font-weight-bold">Khách hàng</label>
                    @Html.DropDownList("maKH", null, htmlAttributes: new { @class = "form-control" })
                </div>
                <div class="form-group col-md-4">
                    <label class="control-label font-weight-bold">Ngày thuê</label>
                    <input type="datetime-local" id="ngayThue" name="ngayThue" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="form-group col-md-4">
                    <label class="control-label font-weight-bold">Ngày trả (Dự kiến)</label>
                    <input type="datetime-local" id="ngayTra" name="ngayTra" class="form-control" />
                </div>
            </div>
        }
    </div>

    <div class="detail-card">
        <h3 class="section-title section-title-detail"><i class="fas fa-concierge-bell"></i> Chi tiết sử dụng dịch vụ & phòng</h3>
        <hr />

        <div class="row align-items-end">
            <div class="form-group col-md-2">
                <label class="font-weight-bold">Phòng</label>
                @Html.DropDownList("maP", null, "-- Chọn --", htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-group col-md-3">
                <label class="font-weight-bold">Dịch vụ</label>
                @Html.DropDownList("maDV", null, "Không sử dụng dịch vụ", htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-group col-md-3">
                <label class="font-weight-bold">Ngày sử dụng</label>
                <input type="datetime-local" id="ngaySD" name="ngaySD" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
            <div class="form-group col-md-2">
                <label class="font-weight-bold">Số lượng</label>
                <input type="number" id="soLuong" name="soLuong" class="form-control" value="1" min="1" />
            </div>
            <div class="form-group col-md-2">
                <button id="addToList" class="btn btn-primary btn-block"><i class="fas fa-plus"></i> Thêm vào danh sách</button>
            </div>
        </div>

        <div class="table-responsive mt-4">
            <table id="detailsTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Phòng</th>
                        <th>Dịch vụ</th>
                        <th>Ngày sử dụng</th>
                        <th>Số lượng</th>
                        <th class="text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @* Dữ liệu thêm từ JS sẽ nằm ở đây *@
                </tbody>
            </table>
        </div>

        <div class="mt-4 border-top pt-3 text-right">
            <button id="saveOrder" class="btn btn-danger btn-lg px-5 shadow-sm"><i class="fas fa-save"></i> LƯU PHIẾU THUÊ</button>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="@Url.Action("Index")" class="btn btn-link text-secondary"><i class="fas fa-arrow-left"></i> Trở về danh sách</a>
</div>