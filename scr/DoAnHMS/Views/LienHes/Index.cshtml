@model List<DoAnHMS.Models.LienHe>

@{
    ViewBag.title = "Quản lý Liên hệ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var grid = new WebGrid(Model, canPage: true, rowsPerPage: 10);
}

<style type="text/css">
   
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
    }

    .dashboard-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        padding: 30px;
        margin-top: 20px;
        position: relative;
    }

        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--luxury-gold);
        }

    .table-luxury {
        border-collapse: separate;
        border-spacing: 0 10px;
        width: 100%;
        margin-top: 20px;
    }

        .table-luxury th {
            background-color: transparent !important;
            color: var(--luxury-navy) !important;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            border: none !important;
            padding: 15px !important;
            border-bottom: 2px solid #f1f1f1 !important;
        }

        .table-luxury td {
            background: #fff;
            border: none !important;
            padding: 20px 15px !important;
            vertical-align: middle !important;
            font-size: 14px;
            color: #444;
            border-bottom: 1px solid #f9f9f9 !important;
            transition: all 0.3s;
        }

        .table-luxury tr:hover td {
            background-color: #fcfaf5;
        }

   
    .status-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 5px 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 0;
    }

    .status-processed {
        background-color: #e6f4ea;
        color: #1e7e34;
        border: 1px solid #c3e6cb;
    }

    .status-pending {
        background-color: #fff3e0;
        color: #e65100;
        border: 1px solid #ffe0b2;
    }

    /* Paging */
    .grid-footer {
        text-align: center;
        padding-top: 30px;
    }

        .grid-footer a {
            color: var(--luxury-navy);
            padding: 8px 16px;
            text-decoration: none;
            border: 1px solid #eee;
            margin: 0 4px;
            font-size: 12px;
            font-weight: 700;
            transition: all 0.3s;
        }

            .grid-footer a:hover {
                background: var(--luxury-gold);
                color: #fff;
                border-color: var(--luxury-gold);
            }

    /* Action Buttons */
    .btn-action {
        color: #999;
        margin: 0 8px;
        transition: color 0.2s;
    }

        .btn-action:hover {
            color: var(--luxury-gold);
            text-decoration: none;
        }
</style>

<div class="container-fluid">
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 style="font-family: 'Playfair Display', serif; color: var(--luxury-navy); letter-spacing: 1px; font-weight: 700;">DANH SÁCH YÊU CẦU LIÊN HỆ</h3>
                <p class="text-muted small">Quản lý các phản hồi và yêu cầu hỗ trợ từ cổng Website</p>
            </div>
        </div>

        <div id="gridContent" class="table-responsive">
            @grid.GetHtml(
                tableStyle: "table table-luxury",
                footerStyle: "grid-footer",
                mode: WebGridPagerModes.All,
                columns: grid.Columns(
                    grid.Column("STT", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + (grid.PageIndex * grid.RowsPerPage), style: "text-center"),

                    grid.Column("hoTen", "Người gửi", format: @<text><b style="color: #1a1d2e">@item.hoTen</b></text>),

grid.Column("sdt", "Liên lạc", format: @<text>
                    <div><i class="fas fa-phone-alt mr-2" style="font-size: 10px; color: #c5a059"></i>@item.sdt</div>
                    <div class="small text-muted mt-1"><i class="fas fa-envelope mr-2" style="font-size: 10px; color: #c5a059"></i>@item.email</div>
</text>),

grid.Column("ngayGui", "Thời gian nhận", format: @<text>
    <div class="small font-weight-bold">@item.ngayGui.ToString("dd/MM/yyyy")</div>
    <div class="small text-muted">@item.ngayGui.ToString("HH:mm")</div>
</text>),

grid.Column("tinhTrang", "Trạng thái", format: @<text>
    @if (item.tinhTrang == true)
    {
        <span class="status-badge status-processed">Đã xử lý</span>
    }
    else
    {
        <span class="status-badge status-pending">Chưa xử lý</span>
    }
</text>, style: "text-center"),

grid.Column("Thao tác", format: @<text>
    <a href="@Url.Action("Edit", new { id = item.id })" class="btn-action" title="Cập nhật trạng thái"><i class="fas fa-reply"></i></a>
    <a href="@Url.Action("Details", new { id = item.id })" class="btn-action" title="Xem nội dung"><i class="fas fa-eye"></i></a>
    <a href="@Url.Action("Delete", new { id = item.id })" class="btn-action" title="Xóa liên hệ"><i class="fas fa-trash-alt"></i></a>
</text>, style: "text-center")
)
)
        </div>
    </div>
</div>