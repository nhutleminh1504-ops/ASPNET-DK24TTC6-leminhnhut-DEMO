@model DoAnHMS.Models.LienHe

@{
    ViewBag.Title = "Cập nhật yêu cầu liên hệ";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --soft-gray: #f8f9fa;
    }

    .edit-container {
        padding: 40px 0;
        background-color: var(--soft-gray);
    }

    .edit-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 15px 50px rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
    }

        .edit-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--luxury-gold);
        }

    .card-header-luxury {
        padding: 40px 40px 20px;
        background: #fff;
        border-bottom: none;
    }

        .card-header-luxury h3 {
            font-family: 'Playfair Display', serif;
            color: var(--luxury-navy);
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 1.4rem;
        }

    .card-body-luxury {
        padding: 20px 40px 40px;
    }

   
    .form-label-luxury {
        font-size: 11px;
        font-weight: 700;
        color: var(--luxury-gold);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .input-readonly-luxury {
        background-color: #fafafa !important;
        border: none !important;
        border-bottom: 1px solid #eee !important;
        border-radius: 0 !important;
        color: #444 !important;
        font-weight: 500;
        padding-left: 0 !important;
        box-shadow: none !important;
        cursor: default;
    }

    /* Radio Custom Design */
    .status-selection {
        background: #fcfcfc;
        border: 1px solid #eee;
        padding: 25px;
        margin: 30px 0;
    }

    .radio-option {
        margin-right: 30px;
        cursor: pointer;
        font-weight: 600;
        color: var(--luxury-navy);
        transition: color 0.3s;
    }

        .radio-option input[type="radio"] {
            accent-color: var(--luxury-gold);
            transform: scale(1.2);
            margin-right: 10px;
        }

    /* Buttons */
    .btn-luxury-save {
        background: var(--luxury-navy);
        color: #fff;
        border-radius: 0;
        padding: 15px 45px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: none;
        transition: all 0.4s;
    }

        .btn-luxury-save:hover {
            background: var(--luxury-gold);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
        }

    .btn-back-link {
        color: #999;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
        font-weight: 700;
    }

        .btn-back-link:hover {
            color: var(--luxury-navy);
            text-decoration: none;
        }
</style>

<div class="edit-container">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="edit-card">
                <div class="card-header-luxury">
                    <h3>Cập nhật tình trạng xử lý</h3>
                    <p class="text-muted small">Mã yêu cầu: <strong>#@Model.id</strong></p>
                </div>

                <div class="card-body-luxury">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })
                        @Html.HiddenFor(model => model.id)

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label-luxury">Khách hàng gửi</label>
                                @Html.EditorFor(model => model.hoTen, new { htmlAttributes = new { @class = "form-control input-readonly-luxury", @readonly = "readonly" } })
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label-luxury">Thời gian nhận</label>
                                @Html.EditorFor(model => model.ngayGui, new { htmlAttributes = new { @class = "form-control input-readonly-luxury", @readonly = "readonly" } })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label-luxury">Số điện thoại</label>
                                @Html.EditorFor(model => model.sdt, new { htmlAttributes = new { @class = "form-control input-readonly-luxury", @readonly = "readonly" } })
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label-luxury">Email liên lạc</label>
                                @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control input-readonly-luxury", @readonly = "readonly" } })
                            </div>
                        </div>

                        <div class="status-selection">
                            <label class="form-label-luxury d-block mb-3">Trạng thái phản hồi</label>
                            <div class="d-flex">
                                <label class="radio-option">
                                    @Html.RadioButtonFor(model => model.tinhTrang, "True") Đã xử lý hoàn tất
                                </label>
                                <label class="radio-option">
                                    @Html.RadioButtonFor(model => model.tinhTrang, "False") Đang chờ giải quyết
                                </label>
                            </div>
                            @Html.ValidationMessageFor(model => model.tinhTrang, "", new { @class = "text-danger small mt-2 d-block" })
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a href="@Url.Action("Index")" class="btn-back-link">
                                <i class="fas fa-chevron-left mr-2"></i> Trở về danh sách
                            </a>
                            <button type="submit" class="btn btn-luxury-save shadow-sm">
                                Cập nhật ngay <i class="fas fa-check-circle ml-2"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>