@model DoAnHMS.Models.NhomNhanVien

@{
    ViewBag.Title = "Gỡ bỏ nhóm quyền";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    :root {
        --luxury-danger: #8b0000;
        --luxury-navy: #1a1d2e;
        --luxury-gold: #c5a059;
    }

    .delete-page-wrapper {
        padding: 60px 0;
        background-color: #f8f9fa;
        min-height: 90vh;
    }

    .confirm-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 20px 60px rgba(0,0,0,0.06);
        position: relative;
        overflow: hidden;
    }

        /* Thanh cảnh báo màu đỏ rượu vang */
        .confirm-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--luxury-danger);
        }

    .card-header-warning {
        padding: 40px;
        text-align: center;
        border-bottom: 1px solid #f1f1f1;
    }

        .card-header-warning i {
            font-size: 3rem;
            color: var(--luxury-danger);
            margin-bottom: 20px;
        }

        .card-header-warning h3 {
            font-family: 'Playfair Display', serif;
            color: var(--luxury-danger);
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-size: 1.3rem;
            margin: 0;
        }

    .card-body-luxury {
        padding: 40px 60px;
    }

    /* Khối thông tin nhóm */
    .role-info-box {
        background: #fcfcfc;
        border: 1px solid #eee;
        padding: 30px;
        margin-bottom: 40px;
        text-align: center;
    }

    .role-id-label {
        font-size: 11px;
        color: var(--luxury-gold);
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        display: block;
        margin-bottom: 10px;
    }

    .role-name-display {
        font-size: 1.8rem;
        color: var(--luxury-navy);
        font-weight: 700;
        font-family: 'Playfair Display', serif;
    }

    /* Nút bấm */
    .btn-delete-final {
        background: var(--luxury-danger);
        color: #fff;
        border: none;
        border-radius: 0;
        padding: 15px 40px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        transition: 0.4s;
    }

        .btn-delete-final:hover {
            background: #000;
            color: #fff;
            transform: translateY(-2px);
        }

    .btn-cancel-link {
        color: #999;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        text-decoration: none;
        margin-right: 25px;
        transition: 0.3s;
    }

        .btn-cancel-link:hover {
            color: var(--luxury-navy);
            text-decoration: underline;
        }
</style>

<div class="delete-page-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="confirm-card">
                    <div class="card-header-warning">
                        <i class="fas fa-shield-alt"></i>
                        <h3>Xác nhận gỡ bỏ nhóm</h3>
                        <p class="text-muted small mt-2">Lưu ý: Xóa nhóm quyền có thể ảnh hưởng đến khả năng truy cập của các nhân viên thuộc nhóm này.</p>
                    </div>

                    <div class="card-body-luxury">
                        <div class="role-info-box">
                            <span class="role-id-label">Mã định danh: #@Model.IDNhom</span>
                            <div class="role-name-display">@Model.TenNhom</div>
                        </div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            <div class="d-flex justify-content-center align-items-center">
                                <a href="@Url.Action("Index")" class="btn-cancel-link">Hủy bỏ thao tác</a>
                                <button type="submit" class="btn btn-delete-final shadow">
                                    Xác nhận xóa nhóm <i class="fas fa-trash-alt ml-2"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>