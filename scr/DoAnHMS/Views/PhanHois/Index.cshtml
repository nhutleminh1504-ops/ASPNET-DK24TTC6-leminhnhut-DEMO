@model IEnumerable<DoAnHMS.Models.PhanHoi>

@{
    ViewBag.Title = "Quản lý phản hồi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var grid = new WebGrid(Model, canPage: true, defaultSort: "id", rowsPerPage: 10);
}

<style type="text/css">
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --luxury-bg: #f8f9fa;
    }

    .dashboard-card {
        background: #fff;
        border: none;
        border-radius: 0;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        padding: 30px;
        margin-top: 20px;
        position: relative;
    }

        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--luxury-gold);
        }

    /* Table Design */
    .table-luxury {
        width: 100%;
        margin-top: 20px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-luxury th {
            background-color: #fcfcfc !important;
            color: var(--luxury-navy) !important;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 700;
            padding: 15px !important;
            border-bottom: 2px solid #eee !important;
            border-top: none !important;
        }

        .table-luxury td {
            padding: 18px 15px !important;
            vertical-align: middle !important;
            font-size: 14px;
            border-bottom: 1px solid #f1f1f1 !important;
        }

 
    .content-truncate {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #666;
        font-style: italic;
    }

  
    .status-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 4px 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: inline-block;
    }

    .status-done {
        background-color: #e6f4ea;
        color: #1e7e34;
        border: 1px solid #c3e6cb;
    }

    .status-wait {
        background-color: #fff3e0;
        color: #e65100;
        border: 1px solid #ffe0b2;
    }

    
    .grid-footer {
        text-align: center;
        padding-top: 30px;
    }

        .grid-footer a {
            color: var(--luxury-navy);
            padding: 8px 14px;
            text-decoration: none;
            border: 1px solid #eee;
            margin: 0 3px;
            font-size: 12px;
            transition: all 0.3s;
        }

            .grid-footer a:hover {
                background: var(--luxury-gold);
                color: #fff;
                border-color: var(--luxury-gold);
            }

    .btn-action {
        color: #bbb;
        margin: 0 5px;
        font-size: 16px;
        transition: color 0.3s;
    }

        .btn-action:hover {
            color: var(--luxury-gold);
            text-decoration: none;
        }
</style>

<div class="container-fluid luxury-wrapper">
    <div class="dashboard-card">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 style="font-family: 'Playfair Display', serif; color: var(--luxury-navy); letter-spacing: 1px; font-weight: 700;">PHẢN HỒI TỪ KHÁCH HÀNG</h3>
                <p class="text-muted small">Lắng nghe ý kiến từ khách hàng để nâng cao chất lượng dịch vụ 5 sao</p>
            </div>
        </div>

        <div id="gridContent" class="table-responsive">
            @grid.GetHtml(
                tableStyle: "table table-luxury",
                footerStyle: "grid-footer",
                mode: WebGridPagerModes.All,
                columns: grid.Columns(
                    grid.Column("STT", format: item => item.WebGrid.Rows.IndexOf(item) + 1 + (grid.PageIndex * grid.RowsPerPage), style: "text-center"),

                    grid.Column("hoTen", "Khách hàng", format: @<text><strong style="color: var(--luxury-navy)">@item.hoTen</strong></text>),

grid.Column("Liên lạc", format: @<text>
                    <div class="small"><i class="fas fa-phone mr-1" style="color: var(--luxury-gold)"></i> @item.sdt</div>
                    <div class="small text-muted"><i class="fas fa-envelope mr-1" style="color: var(--luxury-gold)"></i> @item.email</div>
</text>),

grid.Column("noiDung", "Nội dung phản hồi", format: @<text><div class="content-truncate">@item.noiDung</div></text>),

grid.Column("ngayGui", "Ngày gửi", format: @<text>@item.ngayGui.ToString("dd/MM/yyyy HH:mm")</text>),

grid.Column("tinhTrang", "Trạng thái", format: @<text>
    @if (item.tinhTrang == true)
    {
        <span class="status-badge status-done">Đã ghi nhận</span>
    }
    else
    {
        <span class="status-badge status-wait">Mới</span>
    }
</text>, style: "text-center"),

grid.Column("Thao tác", format: @<text>
    <a href="@Url.Action("Edit", new { id = item.id })" class="btn-action" title="Xử lý"><i class="fas fa-check-double"></i></a>
    <a href="@Url.Action("Details", new { id = item.id })" class="btn-action" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
    <a href="@Url.Action("Delete", new { id = item.id })" class="btn-action" title="Xóa"><i class="fas fa-trash-alt"></i></a>
</text>, style: "text-center")
)
)
        </div>
    </div>
</div>