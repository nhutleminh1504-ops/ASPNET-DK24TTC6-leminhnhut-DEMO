@model DoAnHMS.Models.PhanHoi

@{
    ViewBag.Title = "Gửi ý kiến phản hồi";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Sử dụng Layout khách hàng
}

<style>
    /* Bảng màu Luxury cho Client-side */
    :root {
        --gold-primary: #c5a059;
        --navy-dark: #1a1d2e;
        --white-pure: #ffffff;
    }

    .feedback-page {
        padding: 80px 0;
        background: url('/images/hotel-bg-pattern.png') repeat; /* Bạn có thể thêm pattern nhẹ */
        background-color: #fcfcfc;
    }

    .feedback-form-card {
        background: var(--white-pure);
        border: none;
        border-radius: 0;
        box-shadow: 0 30px 70px rgba(0,0,0,0.07);
        padding: 50px;
        position: relative;
    }

        /* Điểm nhấn vương miện/logo nhỏ phía trên */
        .feedback-form-card::before {
            content: "\f5a2"; /* FontAwesome Hotel Icon */
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            position: absolute;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 50px;
            background: var(--gold-primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 20px rgba(197, 160, 89, 0.3);
        }

    .form-header-luxury {
        text-align: center;
        margin-bottom: 40px;
    }

        .form-header-luxury h2 {
            font-family: 'Playfair Display', serif;
            color: var(--navy-dark);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .form-header-luxury p {
            color: var(--gold-primary);
            font-style: italic;
            letter-spacing: 1px;
        }

    /* Định dạng các ô nhập liệu */
    .luxury-input-group {
        margin-bottom: 30px;
    }

    .luxury-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #999;
        margin-bottom: 10px;
        display: block;
    }

    .luxury-control {
        border: none !important;
        border-bottom: 1px solid #e0e0e0 !important;
        border-radius: 0 !important;
        padding: 12px 0 !important;
        font-size: 15px;
        color: var(--navy-dark);
        background: transparent !important;
        box-shadow: none !important;
        transition: all 0.3s ease;
    }

        .luxury-control:focus {
            border-bottom: 1px solid var(--gold-primary) !important;
        }

    /* Ô nội dung tin nhắn lớn hơn */
    .luxury-textarea {
        min-height: 120px;
        resize: none;
    }

    /* Nút gửi phong cách hoàng gia */
    .btn-send-feedback {
        background: var(--navy-dark);
        color: var(--white-pure);
        border: none;
        border-radius: 0;
        padding: 15px 50px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 3px;
        transition: all 0.4s ease;
        width: 100%;
        cursor: pointer;
    }

        .btn-send-feedback:hover {
            background: var(--gold-primary);
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(197, 160, 89, 0.3);
        }

    .back-to-home {
        display: block;
        text-align: center;
        margin-top: 30px;
        color: #bbb;
        text-decoration: none;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .back-to-home:hover {
            color: var(--gold-primary);
        }
</style>

<div class="feedback-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="feedback-form-card">

                    <div class="form-header-luxury">
                        <h2>Lời nhắn từ quý khách</h2>
                        <p>Trân trọng mọi ý kiến đóng góp để hoàn thiện dịch vụ</p>
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-4" })

                        <div class="row">
                            <div class="col-md-6">
                                <div class="luxury-input-group">
                                    <label class="luxury-label">Danh xưng & Họ tên</label>
                                    @Html.EditorFor(model => model.hoTen, new { htmlAttributes = new { @class = "form-control luxury-control", placeholder = "Quý khách tên là..." } })
                                    @Html.ValidationMessageFor(model => model.hoTen, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="luxury-input-group">
                                    <label class="luxury-label">Số điện thoại</label>
                                    @Html.EditorFor(model => model.sdt, new { htmlAttributes = new { @class = "form-control luxury-control", placeholder = "090x xxx xxx" } })
                                    @Html.ValidationMessageFor(model => model.sdt, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>

                        <div class="luxury-input-group">
                            <label class="luxury-label">Địa chỉ thư điện tử (Email)</label>
                            @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control luxury-control", placeholder = "khachhang@example.com" } })
                            @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="luxury-input-group">
                            <label class="luxury-label">Ý kiến đóng góp</label>
                            @Html.TextAreaFor(model => model.noiDung, new { @class = "form-control luxury-control luxury-textarea", placeholder = "Quý khách có điều gì chưa hài lòng hoặc muốn khen ngợi dịch vụ của chúng tôi?" })
                            @Html.ValidationMessageFor(model => model.noiDung, "", new { @class = "text-danger small" })
                        </div>

                        @* Ẩn ngày gửi, Controller sẽ tự gán DateTime.Now *@
                        @Html.HiddenFor(model => model.ngayGui, new { @Value = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") })

                        <div class="text-center mt-5">
                            <button type="submit" class="btn btn-send-feedback shadow">
                                Gửi lời nhắn trân trọng <i class="fas fa-paper-plane ml-2"></i>
                            </button>
                        </div>
                    }

                    <a href="/" class="back-to-home">
                        <i class="fas fa-long-arrow-alt-left mr-2"></i> Trở về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>