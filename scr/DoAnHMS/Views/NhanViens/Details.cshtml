@model DoAnHMS.Models.NhanVien

@{
    ViewBag.Title = "Hồ sơ chi tiết nhân viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    // Lấy tên nhóm từ quan hệ QuanTris
    var account = Model.QuanTris.FirstOrDefault(x => x.maNV == Model.maNV);
    string tenNhom = account != null ? account.NhomNhanVien.TenNhom : "Chưa phân nhóm";
}

<style>
    :root {
        --luxury-gold: #c5a059;
        --luxury-navy: #1a1d2e;
        --soft-bg: #f4f7f6;
    }

    .profile-wrapper {
        padding: 50px 0;
        background-color: var(--soft-bg);
        min-height: 90vh;
    }

    .profile-card {
        background: #fff;
        border: none;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-wrap: wrap;
    }

        /* Đường kẻ trang trí phía trên */
        .profile-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--luxury-gold);
        }

    /* Cột trái: Hình ảnh & Chức vụ chính */
    .profile-sidebar {
        flex: 0 0 350px;
        background: #fcfcfc;
        padding: 60px 40px;
        text-align: center;
        border-right: 1px solid #f1f1f1;
    }

    .profile-img-container {
        width: 180px;
        height: 180px;
        margin: 0 auto 30px;
        border-radius: 50%;
        border: 4px solid #fff;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        overflow: hidden;
    }

        .profile-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .profile-sidebar h2 {
        font-family: 'Playfair Display', serif;
        color: var(--luxury-navy);
        font-weight: 700;
        margin-bottom: 10px;
        text-transform: uppercase;
        font-size: 1.5rem;
    }

    .role-badge {
        display: inline-block;
        padding: 6px 20px;
        background: var(--luxury-gold);
        color: #fff;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
    }

    /* Cột phải: Thông tin chi tiết */
    .profile-main {
        flex: 1;
        padding: 60px;
        min-width: 400px;
    }

    .section-title {
        font-size: 11px;
        font-weight: 700;
        color: #bbb;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 30px;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px 20px;
    }

    .info-item label {
        display: block;
        font-size: 10px;
        color: var(--luxury-gold);
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .info-item span {
        font-size: 1rem;
        color: var(--luxury-navy);
        font-weight: 500;
    }

    /* Nút bấm */
    .profile-actions {
        margin-top: 50px;
        display: flex;
        gap: 15px;
    }

    .btn-luxury-edit {
        background: var(--luxury-navy);
        color: #fff;
        padding: 12px 35px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: 0.4s;
        text-decoration: none;
    }

        .btn-luxury-edit:hover {
            background: var(--luxury-gold);
            color: #fff;
            transform: translateY(-3px);
        }

    .btn-luxury-back {
        padding: 12px 25px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #999;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-luxury-back:hover {
            color: var(--luxury-navy);
        }
</style>

<div class="profile-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="profile-card">

                    <div class="profile-sidebar">
                        <div class="profile-img-container">
                            <img src="~/Images/@Model.hinhAnh" onerror="this.src='/Images/avatar.png'" alt="Avatar" />
                        </div>
                        <h2>@Model.tenNV</h2>
                        <div class="role-badge">@tenNhom</div>

                        <div style="margin-top: 40px; text-align: left; padding: 0 20px;">
                            <div class="small text-muted mb-2">
                                <i class="fas fa-id-card mr-2" style="color:var(--luxury-gold)"></i> Mã: <strong>@Model.maNV</strong>
                            </div>
                            <div class="small text-muted mb-2">
                                <i class="fas fa-phone mr-2" style="color:var(--luxury-gold)"></i> @Model.sdt
                            </div>
                            <div class="small text-muted">
                                <i class="fas fa-envelope mr-2" style="color:var(--luxury-gold)"></i> @Model.email
                            </div>
                        </div>
                    </div>

                    <div class="profile-main">
                        <div class="section-title">Thông tin hồ sơ nhân sự</div>

                        <div class="info-grid">
                            <div class="info-item">
                                <label>Giới tính</label>
                                <span>@(Model.gioiTinh == true ? "Nam" : "Nữ")</span>
                            </div>
                            <div class="info-item">
                                <label>Ngày sinh</label>
                                <span>@Model.ngaySinh.ToString("dd / MM / yyyy")</span>
                            </div>
                            <div class="info-item" style="grid-column: span 2;">
                                <label>Địa chỉ thường trú</label>
                                <span>@Model.diaChi</span>
                            </div>
                            <div class="info-item">
                                <label>Hệ thống</label>
                                <span>Hoang Gia Hotel Luxury Management</span>
                            </div>
                            <div class="info-item">
                                <label>Trạng thái</label>
                                <span class="text-success"><i class="fas fa-circle mr-1" style="font-size: 8px;"></i> Đang hoạt động</span>
                            </div>
                        </div>

                        <div class="profile-actions">
                            <a href="@Url.Action("Edit", new { id = Model.maNV })" class="btn-luxury-edit shadow-sm">Cập nhật hồ sơ</a>
                            <a href="@Url.Action("Index")" class="btn-luxury-back">Quay lại danh sách</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>